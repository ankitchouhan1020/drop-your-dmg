{
  "name": "drop-your-dmg",
  "version": "0.1.1",
  "description": "An agent skill that designs and builds branded macOS drag-to-Applications DMGs.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-skill",
    "agent-skill",
    "macos",
    "dmg",
    "installer",
    "create-dmg"
  ],
  "license": "MIT",
  "author": "Ankit Chouhan",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "SKILL.md",
    "agents",
    "evals",
    "examples",
    "references",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "examples": "node examples/notion/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run examples && npm run check && npm test"
  },
  "pi": {
    "skills": [
      "./SKILL.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitchouhan1020/drop-your-dmg.git"
  },
  "homepage": "https://github.com/ankitchouhan1020/drop-your-dmg#readme",
  "bugs": {
    "url": "https://github.com/ankitchouhan1020/drop-your-dmg/issues"
  }
}
